<idea-plugin>
    <id>com.github.petrmakhnev.intellij-mojo</id>
    <name>Mojo</name>
    <vendor>Petr Makhnev</vendor>
    <description><![CDATA[
        <p>Native Mojo language support for IntelliJ Platform IDEs.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MojoBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceImplementation="com.github.petrmakhnev.intellijmojo.lang.psi.MojoPsiManager"/>
        <fileType
                name="Mojo"
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.MojoFileType"
                fieldName="INSTANCE"
                extensions="mojo"/>
        <internalFileTemplate name="Mojo File"/>
        <lang.parserDefinition
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.parser.MojoParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.highlighting.MojoSyntaxHighlighterFactory"/>
        <annotator
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.highlighting.MojoSemanticAnnotator"/>
        <colorSettingsPage
                implementation="com.github.petrmakhnev.intellijmojo.ide.colors.MojoColorSettingsPage"/>
        <projectConfigurable
                instance="com.github.petrmakhnev.intellijmojo.ide.settings.MojoProjectConfigurable"
                groupId="language"
                id="language.mojo"
                bundle="messages.MojoBundle"
                key="plugin.name"/>
        <additionalLibraryRootsProvider
                implementation="com.github.petrmakhnev.intellijmojo.ide.settings.MojoStdlibLibraryRootsProvider"/>
        <lang.braceMatcher
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.editor.MojoBraceMatcher"/>
        <lang.commenter
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.editor.MojoCommenter"/>
        <lang.quoteHandler
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.editor.MojoQuoteHandler"/>
        <lineIndentProvider
                implementation="com.github.petrmakhnev.intellijmojo.lang.editor.MojoLineIndentProvider"/>
        <lang.foldingBuilder
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.editor.MojoFoldingBuilder"/>
        <lang.findUsagesProvider
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.ide.MojoFindUsagesProvider"/>
        <findUsagesHandlerFactory
                implementation="com.github.petrmakhnev.intellijmojo.lang.ide.MojoFindUsagesHandlerFactory"/>
        <referencesSearch
                implementation="com.github.petrmakhnev.intellijmojo.lang.ide.MojoConstructorReferencesSearch"/>
        <codeInsight.declarativeInlayProvider
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.ide.hints.MojoTypeHintsProvider"
                group="TYPES_GROUP"
                isEnabledByDefault="true"
                bundle="messages.MojoBundle"
                nameKey="inlay.hints.types"
                descriptionKey="inlay.hints.types.description"
                providerId="mojo.types.hints">
            <option
                    optionId="hint.type.variable"
                    enabledByDefault="true"
                    bundle="messages.MojoBundle"
                    nameKey="inlay.hints.types.variables"
                    descriptionKey="inlay.hints.types.variables.description"/>
        </codeInsight.declarativeInlayProvider>
        <codeInsight.typeInfo
                language="Mojo"
                implementationClass="com.github.petrmakhnev.intellijmojo.lang.ide.hints.MojoTypeProvider"/>
        <indexPatternBuilder
                implementation="com.github.petrmakhnev.intellijmojo.lang.indexing.MojoIndexPatternBuilder"/>
        <stubIndex implementation="com.github.petrmakhnev.intellijmojo.lang.stub.index.MojoNamedElementIndex"/>
        <stubIndex implementation="com.github.petrmakhnev.intellijmojo.lang.stub.index.MojoFunctionIndex"/>
        <stubIndex implementation="com.github.petrmakhnev.intellijmojo.lang.stub.index.MojoTypeIndex"/>
        <stubIndex implementation="com.github.petrmakhnev.intellijmojo.lang.stub.index.MojoStructIndex"/>
        <stubIndex implementation="com.github.petrmakhnev.intellijmojo.lang.stub.index.MojoTraitIndex"/>
        <stubIndex implementation="com.github.petrmakhnev.intellijmojo.lang.stub.index.MojoModuleIndex"/>
        <stubElementTypeHolder
                class="com.github.petrmakhnev.intellijmojo.lang.psi.MojoTypes"
                externalIdPrefix="mojo."/>
    </extensions>

    <actions>
        <action
                id="Mojo.NewFile"
                class="com.github.petrmakhnev.intellijmojo.ide.actions.CreateMojoFileAction"
                text="Mojo File"
                description="Create a new Mojo source file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
